    "npc-liu": {
      "name": "劉大娘",
      "talks": [
        {
          "id": "liu-night",
          "when": {
            "time": "night"
          },
          "script": {
            "schema": "SHANHE_EVENT_SCRIPT_V0_1",
            "id": "liu-night",
            "title": "劉大娘",
            "start": "a",
            "scenes": {
              "a": {
                "type": "end",
                "lines": [
                  {
                    "text": "沒有燈。別吵醒大娘。"
                  }
                ]
              }
            }
          }
        },
        {
          "id": "liu-first",
          "when": {
            "not": {
              "flag": "talked.liu-first"
            }
          },
          "script": {
            "schema": "SHANHE_EVENT_SCRIPT_V0_1",
            "id": "liu-first",
            "title": "劉大娘",
            "start": "a",
            "scenes": {
              "a": {
                "type": "choice",
                "lines": [
                  {
                    "text": "劉大娘正好推開門，手裡拎著一桶水。看見她，愣了一下。"
                  },
                  {
                    "speaker": "劉大娘",
                    "text": "「哎喲，這是掉哪個坑裡了？過來過來。」"
                  }
                ],
                "choices": [
                  {
                    "id": "wipe",
                    "label": "讓大娘擦",
                    "next": "wipe"
                  },
                  {
                    "id": "self",
                    "label": "「我自己來。」",
                    "next": "self"
                  }
                ]
              },
              "wipe": {
                "type": "end",
                "lines": [
                  {
                    "text": "劉大娘撩起水，替她把臉擦了一遍，又擦一遍。泥是淡了，臉也花了。"
                  },
                  {
                    "speaker": "劉大娘",
                    "text": "「越擦越花。算了，去吧，別往江邊跑。」"
                  }
                ],
                "effects": [
                  {
                    "set_flag": "face.wiped"
                  }
                ]
              },
              "self": {
                "type": "end",
                "lines": [
                  {
                    "text": "她捧了一把冷水，往臉上一抹。越抹越髒。"
                  },
                  {
                    "speaker": "劉大娘",
                    "text": "（嘆氣）「瘦得跟猴兒似的，還一臉泥。去吧。」"
                  }
                ],
                "effects": [
                  {
                    "set_flag": "face.wiped"
                  }
                ]
              }
            },
            "note": "〔遊戲原創〕；開門打水借第 7 章，「越抹越髒」借第 15 章，「瘦得跟猴兒似的」借第 1 章。"
          }
        },
        {
          "id": "liu-after",
          "when": {},
          "script": {
            "schema": "SHANHE_EVENT_SCRIPT_V0_1",
            "id": "liu-after",
            "title": "劉大娘",
            "start": "a",
            "scenes": {
              "a": {
                "type": "end",
                "lines": [
                  {
                    "speaker": "劉大娘",
                    "text": "「早上的粥喝了沒有？沒喝，周家門口還有人在。」"
                  }
                ]
              }
            }
          }
        }
      ]
    },
