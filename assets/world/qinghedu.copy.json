            "title": "孫嫂",
            "start": "a",
            "scenes": {
              "a": {
                "type": "end",
                "lines": [
                  {
                    "speaker": "孫嫂",
                    "text": "「你這臉是去江裡撈泥鰍了？別湊鏊子邊，泥掉進餅裡我賣給誰？」"
                  }
                ]
              }
            }
          }
        },
        {
          "id": "sun-default",
          "when": {},
          "script": {
            "schema": "SHANHE_EVENT_SCRIPT_V0_1",
            "id": "sun-default",
            "title": "孫嫂",
            "start": "a",
            "scenes": {
              "a": {
                "type": "end",
                "lines": [
                  {
                    "speaker": "孫嫂",
                    "text": "「去去去，小孩子別擋道，這兒正忙著呢！」"
                  }
                ]
              }
            },
            "note": "〔正文〕第 7 章原句，借作忙時的預設。"
