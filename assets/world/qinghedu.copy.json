  "events": {
    "ev-dog-fog": {
      "schema": "SHANHE_EVENT_SCRIPT_V0_1",
      "id": "ev-dog-fog",
      "title": "青禾渡",
      "start": "a",
      "scenes": {
        "a": {
          "type": "choice",
          "lines": [
            {
              "text": "霧裡忽然有狗叫了一聲，不遠。阿禾停住腳。叫醒了一條狗，等於叫醒半個村子。"
            }
          ],
          "choices": [
            {
              "id": "crouch",
              "label": "蹲下不動",
              "next": "crouch"
            },
            {
              "id": "around",
              "label": "繞遠一點走",
              "next": "around"
            },
            {
              "id": "hush",
              "label": "小聲噓牠",
              "next": "hush"
            }
          ]
        },
        "crouch": {
          "type": "end",
          "lines": [
            {
              "text": "她蹲在路邊，大氣也不敢喘。腳步聲啪嗒啪嗒走近，聞了聞她的草鞋，又啪嗒啪嗒走了。"
            }
          ],
          "closing": "沒吵醒人。"
        },
        "around": {
          "type": "end",
          "lines": [
            {
              "text": "她貼著籬笆繞了半圈。狗叫了兩聲，沒人開門。"
            }
          ],
          "closing": "沒吵醒人。"
        },
        "hush": {
          "type": "end",
          "lines": [
            {
              "text": "「噓——」狗歪著頭看她，不叫了，搖了兩下尾巴，回去趴著。牠大概也是值夜的。"
            }
          ],
          "closing": "沒吵醒人。"
        }
      },
      "note": "〔遊戲原創〕路上小事，可整段刪（連同 enc-night-fog）。"
    }
  },
