            "scenes": {
              "a": {
                "type": "end",
                "lines": [
                  {
                    "speaker": "孫嫂",
                    "text": "「焦邊吃了沒？吃了就回去，別在這兒擋道。」"
                  }
                ]
              }
            }
          }
        },
        {
          "id": "sun-before",
          "when": {
            "not": {
              "quest_done": "q-qh-night"
            }
          },
          "script": {
            "schema": "SHANHE_EVENT_SCRIPT_V0_1",
