  "inspects": {
    "ferry-layue": {
      "schema": "SHANHE_EVENT_SCRIPT_V0_1",
      "id": "ferry-layue",
      "title": "渡口・石階",
      "start": "a",
      "scenes": {
        "a": {
          "type": "end",
          "lines": [
            {
              "text": "誰家要什麼，就自己跑到渡口，等船來了，攔住船上的人，說「勞駕下回捎兩斤白麪」，再塞一把錢。"
            },
            {
              "text": "十幾家人，一家一家攔，一家一家說，一家一家塞錢。"
            },
            {
              "text": "一個人要兩斤，進貨的人得跑一趟；十個人各要兩斤，合在一起就是二十斤，跑一趟就夠了。"
            },
            {
              "text": "「合起來買。」她自言自語。"
            }
          ],
          "effects": [
            {
              "set_flag": "hemai.idea"
            }
          ]
        }
      },
      "note": "§5.2〔正文〕第 16 章，刪節。"
    },
    "zhou-layue": {
      "schema": "SHANHE_EVENT_SCRIPT_V0_1",
      "id": "zhou-layue",
      "title": "周家門口",
      "start": "a",
      "scenes": {
        "a": {
          "type": "end",
          "lines": [
            {
              "text": "簷下的鍋還熱著。來喝粥的人，說的多半是年貨。"
            }
          ]
        }
      },
      "note": "補定稿 §三〔遊戲原創〕。"
    }
  },
  "scripts": {
    "layue-open": {
      "schema": "SHANHE_EVENT_SCRIPT_V0_1",
      "id": "layue-open",
      "title": "阿禾的茅棚",
      "start": "a",
      "scenes": {
        "a": {
          "type": "dialogue",
          "lines": [
            {
              "text": "臘月一到，青禾渡的空氣就變了味道。"
            },
            {
              "text": "不是冷的味道，冷早就有了。家家戶戶都在盤算年貨。"
            },
            {
              "text": "孫嫂攤餅的時候盤算：「年三十得蒸一鍋白麪饅頭，今年再窮也得蒸。」"
            },
            {
              "text": "張嬸縫衣裳的時候盤算：「給孩子扯塊布頭做雙新鞋面，過年總不能露著腳趾頭。」"
            },
            {
              "text": "鄭大伯紮茅草的時候盤算：「打兩斤酒。不，一斤。不，還是兩斤。」"
            },
            {
              "text": "阿禾在灶邊添柴，耳朵一樣一樣收進來，心裡默默做了一張表："
            },
            {
              "text": "白麪、紅糖、布頭、針線、燈油、酒、鹽、乾貨。"
            }
          ],
          "advance": "出門",
          "next": "out"
        },
        "out": {
          "type": "end",
          "auto_return": true,
          "effects": [
            {
              "set_season": "layue"
            },
            {
              "set_day": 1
            },
            {
              "set_time": "morning"
            },
            {
              "move_to": "qh-hut"
            }
          ]
        }
      },
      "note": "§5.1〔正文〕第 16 章，刪節。進入臘月的按鈕「過了些日子。」〔遊戲原創〕在區域圖上。"
    },
    "carve": {
      "schema": "SHANHE_EVENT_SCRIPT_V0_1",
      "id": "carve",
      "title": "阿禾的茅棚",
      "start": "a",
      "scenes": {
        "a": {
          "type": "dialogue",
          "lines": [
            {
              "text": "她坐在茅棚門口削了一下午。"
            }
          ],
          "advance": "刻下一根",
          "next": "b"
        },
        "b": {
          "type": "dialogue",
          "lines": [
            {
              "text": "一家一根竹簽。簽頭用刀尖刻那家的記號——李家刻一個「李」，王家刻一個「王」；張嬸家刻一隻雞，鄭大伯家刻一捆草。簽身上，刻要的東西，旁邊用碼子刻斤兩。"
            }
          ],
          "advance": "刻下一根",
          "next": "c"
        },
        "c": {
          "type": "dialogue",
          "lines": [
            {
              "text": "鹽，省成幾筆；糖，照描；麪，也省了。都是照著渡口木牌上的省字描的。"
            }
          ],
          "advance": "刻下一根",
          "next": "d"
        },
        "d": {
          "type": "dialogue",
          "lines": [
            {
              "text": "十一根竹簽，十一戶人家。她用一根草繩串成一串，像一串帳。"
            }
          ],
          "advance": "串起來",
          "next": "e"
        },
        "e": {
          "type": "end",
          "lines": [
            {
              "text": "「合買帖，」她宣布，「完成。」"
            }
          ],
          "effects": [
            {
              "item_add": {
                "id": "tally-bundle",
                "n": 1
              }
            }
          ]
        }
      },
      "note": "§5.3〔正文〕第 16 章，刪節；按鈕〔遊戲原創〕。"
    },
    "collected": {
      "schema": "SHANHE_EVENT_SCRIPT_V0_1",
      "id": "collected",
      "title": "阿禾的茅棚",
      "start": "a",
      "scenes": {
        "a": {
          "type": "end",
          "lines": [
            {
              "text": "十一家收完，她把錢一枚一枚又聽了一遍，裝進一只舊布袋，跟自己胸口那個小布袋分開放。"
            }
          ],
          "effects": [
            {
              "set_flag": "hemai.collected"
            },
            {
              "item_add": {
                "id": "prepaid-bag",
                "n": 1
              }
            },
            {
              "set_day": 10
            }
          ]
        }
      },
      "note": "§5.4 收齊，〔正文〕第 16 章。收齊後日子到臘月初十。"
    },
    "layue-close": {
      "schema": "SHANHE_EVENT_SCRIPT_V0_1",
      "id": "layue-close",
      "title": "阿禾的茅棚",
      "start": "a",
      "scenes": {
        "a": {
          "type": "end",
          "lines": [
            {
              "text": "那天傍晚，阿禾在灶邊把整件事從頭到尾算了一遍。"
            },
            {
              "text": "「……這一單，」她喃喃道，「賺的是錢，賠的是面子。」"
            },
            {
              "text": "麪子。"
            },
            {
              "text": "她想了想，自己先笑出來了。"
            }
          ],
          "effects": [
            {
              "set_flag": "seen.layue-close"
            }
          ]
        }
      },
      "note": "§5.10〔正文〕第 16 章，刪節；不報總數。"
    }
  },
  "npcs": {
    "npc-li": {
      "name": "李家門口",
      "talks": [
        {
          "id": "li-confess",
          "when": {
            "quest_step": [
              "q-qh-hemai",
              "li"
            ]
          },
          "script": {
            "schema": "SHANHE_EVENT_SCRIPT_V0_1",
            "id": "li-confess",
            "title": "李家門口",
            "start": "a",
            "scenes": {
              "a": {
                "type": "choice",
                "lines": [
                  {
                    "text": "李家的老太太接過那個布袋，解開來看了一眼，臉色就變了。"
                  },
                  {
                    "text": "「這是什麼？」"
                  },
                  {
                    "text": "布袋裡，不是白生生的麪粉。是黃褐色的、一片一片的碎屑，聞起來有一股穀殼的味道。麩皮。"
                  },
                  {
                    "text": "「我家要的是白麪，」老太太的聲音有點抖，「過年蒸饅頭的……這是餵雞的東西啊！」"
                  },
                  {
                    "text": "阿禾低頭看那根拴在布袋上的竹簽。扁扁小小的框，加上兩筆長長的腳。看上去，像一個「夫」。"
                  },
                  {
                    "text": "麥加面，是麪。麥加夫，是麩。"
                  }
                ],
                "choices": [
                  {
                    "id": "own",
                    "label": "「是我刻錯了字。」",
                    "next": "right"
                  },
                  {
                    "id": "shop",
                    "label": "「是上游的鋪子裝錯了。」",
                    "next": "wrong"
                  },
                  {
                    "id": "boat",
                    "label": "「是船上捎錯了。」",
                    "next": "wrong"
                  }
                ]
              },
              "wrong": {
                "type": "choice",
                "lines": [
                  {
                    "text": "話到嘴邊，她又嚥了回去。竹簽是她自己刻的。"
                  }
                ],
                "choices": [
                  {
                    "id": "own",
                    "label": "「是我刻錯了字。」",
                    "next": "right"
                  },
                  {
                    "id": "shop",
                    "label": "「是上游的鋪子裝錯了。」",
                    "next": "wrong"
                  },
                  {
                    "id": "boat",
                    "label": "「是船上捎錯了。」",
                    "next": "wrong"
                  }
                ]
              },
              "right": {
                "type": "end",
                "lines": [
                  {
                    "text": "「阿婆，對不起。」她說，「是我刻錯了字，害您拿到麩皮。白麪的錢，我賠給您。」"
                  },
                  {
                    "text": "「你……你刻的？」"
                  },
                  {
                    "text": "「嗯。」阿禾抬起頭，把竹簽遞過去，「我照著木牌上的樣子描的，描歪了。」"
                  },
                  {
                    "text": "她從自己胸口的小布袋裡，數出六文錢。一枚一枚，雙手捧著，放進老太太手心。"
                  },
                  {
                    "text": "「年前沒有船了。」她說，「白麪，我去孫嫂那兒問問，她買了五斤，看能不能先勻您二斤。差的那幾斤，開春頭一趟船，我再替孫嫂補上。」"
                  },
                  {
                    "text": "最後，老太太嘆了一口氣，把錢塞回阿禾手裡一半。"
                  },
                  {
                    "text": "「三文就夠了。」她說，「麩皮我也不退了。家裡那幾隻雞，過年也該吃頓好的。」"
                  },
                  {
                    "text": "她轉身進屋，再出來時，手裡多了一把炒豆，往阿禾手心裡一倒。"
                  },
                  {
                    "text": "「拿著，炒得香。下回刻字，慢點刻。」"
                  }
                ],
                "closing": "賠三文。得炒豆一把。",
                "effects": [
                  {
                    "set_flag": "li.apologized"
                  },
                  {
                    "wallet_add": -3
                  },
                  {
                    "item_add": {
                      "id": "roasted-beans",
                      "n": 1
                    }
                  }
                ]
              }
            },
            "note": "§5.7〔正文〕第 16 章，刪節；選項〔遊戲原創〕。"
          }
        },
        {
          "id": "li-pay",
          "when": {},
          "script": {
            "schema": "SHANHE_EVENT_SCRIPT_V0_1",
            "id": "li-pay",
            "title": "李家門口",
            "start": "a",
            "scenes": {
              "a": {
                "type": "end",
                "lines": [
                  {
                    "text": "「白麪二斤。過年蒸饅頭的。」"
                  },
                  {
                    "text": "阿禾當面報價、當面收錢、當面把竹簽給人家看一眼，再收回來。"
                  }
                ],
                "effects": [
                  {
                    "set_flag": "paid.li"
                  }
                ]
              }
            },
            "note": "§5.4〔改寫〕。"
          }
        }
      ]
    },
