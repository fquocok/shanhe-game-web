    "npc-west": {
      "name": "村西老漢家",
      "talks": [
        {
          "id": "west-coin",
          "when": {},
          "script": {
            "schema": "SHANHE_EVENT_SCRIPT_V0_1",
            "id": "west-coin",
            "title": "村西老漢家",
            "start": "a",
            "scenes": {
              "a": {
                "type": "choice",
                "lines": [],
                "choices": [
                  {
                    "id": "keep",
                    "label": "收下",
                    "next": "keep"
                  },
                  {
                    "id": "flick",
                    "label": "彈一下聽聽",
                    "next": "flick"
                  }
                ]
              },
              "keep": {
                "type": "choice",
                "lines": [
                  {
                    "text": "錢落進布袋，聲音不太對。她又掏出來。"
                  }
                ],
                "choices": [
                  {
                    "id": "keep",
                    "label": "收下",
                    "next": "keep"
                  },
                  {
                    "id": "flick",
                    "label": "彈一下聽聽",
                    "next": "flick"
                  }
                ]
              },
              "flick": {
                "type": "end",
                "lines": [
                  {
                    "text": "「噗。」"
                  },
                  {
                    "text": "像一顆悶屁。"
                  },
                  {
                    "text": "老漢看她捏著錢不動，有點不高興：「怎麼，嫌少？」"
                  },
                  {
                    "text": "「阿伯，」阿禾把錢遞回去，雙手捧著，客客氣氣，「這枚不響。上回我收了一枚不響的，被人家退回來，賠了自己的錢。您換一枚給我，好不好？」"
                  },
                  {
                    "text": "老漢愣了一下，接過去自己彈了彈，臉色變了：「哎喲，這是我前些日子在下游集上找回來的零錢……」"
                  },
                  {
                    "text": "他嘟嘟囔囔地從錢袋裡另摸了一枚，這回是「叮」的。"
                  }
                ],
                "effects": [
                  {
                    "set_flag": "paid.west"
                  },
                  {
                    "set_flag": "coin.west.swapped"
                  }
                ]
              }
            },
            "note": "§5.4 第一枚不響的錢〔正文〕第 16 章；選項〔遊戲原創〕。"
          }
        }
      ]
    },
